\abx@aux@cite{0}{r10}
\abx@aux@segm{0}{0}{r10}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces An\'alisis Bland--Altman por sensor: $\overline  {d} = \bar  {x}_P - \bar  {y}_R$; l\'imites de concordancia al 95\% calculados como $\overline  {d} \pm 1{,}96\,\sigma _d$.}}{10}{table.caption.8}\protected@file@percent }
\newlabel{tab:bland_altman}{{2}{10}{An\'alisis Bland--Altman por sensor: $\overline {d} = \bar {x}_P - \bar {y}_R$; l\'imites de concordancia al 95\% calculados como $\overline {d} \pm 1{,}96\,\sigma _d$}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces An\'alisis Bland--Altman para los sensores S2, S3 y S4. La l\'inea continua central indica el sesgo medio ($\overline  {d} \approx 0$); las l\'ineas punteadas delimitan los l\'imites de concordancia al 95\%. La ausencia de tendencia en la distribuci\'on de diferencias confirma que el sistema IoT no introduce sesgo sistem\'atico proporcional a la magnitud de la medici\'on. Nota: las etiquetas de la figura se presentan en ingl\'es para facilitar la difusi\'on internacional del resultado.}}{10}{figure.caption.9}\protected@file@percent }
\newlabel{fig:bland_altman}{{6}{10}{An\'alisis Bland--Altman para los sensores S2, S3 y S4. La l\'inea continua central indica el sesgo medio ($\overline {d} \approx 0$); las l\'ineas punteadas delimitan los l\'imites de concordancia al 95\%. La ausencia de tendencia en la distribuci\'on de diferencias confirma que el sistema IoT no introduce sesgo sistem\'atico proporcional a la magnitud de la medici\'on. Nota: las etiquetas de la figura se presentan en ingl\'es para facilitar la difusi\'on internacional del resultado}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}An\'alisis cinem\'atico global}{10}{subsection.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Perfil de velocidad media en funci\'on de la posici\'on del segmento para las modalidades remota (azul) y presencial (rojo). Las barras de error representan $\pm 1\sigma $. La superposici\'on de ambas curvas evidencia la equivalencia cinem\'atica entre modalidades.}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:vel_profile}{{7}{11}{Perfil de velocidad media en funci\'on de la posici\'on del segmento para las modalidades remota (azul) y presencial (rojo). Las barras de error representan $\pm 1\sigma $. La superposici\'on de ambas curvas evidencia la equivalencia cinem\'atica entre modalidades}{figure.caption.10}{}}
\abx@aux@page{65}{11}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Distribuci\'on de la aceleraci\'on experimental estimada para las modalidades remota y presencial ($n = 35$ por modalidad). La pr\'actica identidad de medianas y rangos intercuart\'ilicos confirma la equivalencia estad\'istica entre modalidades.}}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:accel_box}{{8}{12}{Distribuci\'on de la aceleraci\'on experimental estimada para las modalidades remota y presencial ($n = 35$ por modalidad). La pr\'actica identidad de medianas y rangos intercuart\'ilicos confirma la equivalencia estad\'istica entre modalidades}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Posici\'on vs. tiempo: modelo te\'orico de MRUA (l\'inea gris punteada) y datos experimentales de las modalidades remota (azul) y presencial (rojo). La correspondencia entre el modelo te\'orico y los datos experimentales de ambas modalidades valida la precisi\'on del sistema de medici\'on.}}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:mrua_teorico}{{9}{12}{Posici\'on vs. tiempo: modelo te\'orico de MRUA (l\'inea gris punteada) y datos experimentales de las modalidades remota (azul) y presencial (rojo). La correspondencia entre el modelo te\'orico y los datos experimentales de ambas modalidades valida la precisi\'on del sistema de medici\'on}{figure.caption.12}{}}
