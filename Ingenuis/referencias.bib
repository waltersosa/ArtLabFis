@article{Valenzuela2019,
abstract = {<p>This study describes a practical methodology for a resilient planning and routing of power distribution networks considering real scenarios based on georeferenced data. Customers' demand and their location are the basis for distribution transformer allocation considering the minimal construction costs and reduction of utility's budget. MST (Minimum Spanning Tree) techniques are implemented to determine the optimal location of distribution transformers and Medium voltage network routing. Additionally, the allocation of tie points is determined to minimise the total load shedding when unusual and extreme events are faced by the distribution grid, improving reliability and resilience reducing downtime during those events. The proposed methodology provides a coverage of 100%, supplying electricity to the totality of customers within statutory limits during normal and unusual conditions.</p>},
author = {Valenzuela, Alex and Inga, Esteban and Simani, Silvio},
doi = {10.3390/en12040644},
file = {:C\:/Users/Smart_Home/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Valenzuela, Inga, Simani - 2019 - Planning of a Resilient Underground Distribution Network Using Georeferenced Data.pdf:pdf},
issn = {1996-1073},
journal = {Energies},
keywords = {MST techniques,RMU allocation,distribution network planning,resilience,routing},
mendeley-groups = {Zotero - Inga Publicaciones},
month = {feb},
number = {4},
pages = {644},
publisher = {Multidisciplinary Digital Publishing Institute},
title = {{Planning of a Resilient Underground Distribution Network Using Georeferenced Data}},
url = {http://www.mdpi.com/1996-1073/12/4/644},
volume = {12},
year = {2019}
}



